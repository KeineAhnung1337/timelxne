<?xml version="1.0" encoding="UTF-8"?>
<?pde version="3.5"?>
<product name="SWT Timeline Demo" uid="dev.timelxne.timeline.demo.product"
    id="dev.timelxne.timeline.demo.product" application="org.eclipse.e4.ui.workbench.swt.E4Application"
    version="1.0.0.qualifier" useFeatures="true" includeLaunchers="true">
  <configIni use="default"/>
  <launcherArgs>
    <programArgs>-clearPersistedState</programArgs>
    <vmArgs>-Dosgi.requiredJavaVersion=21</vmArgs>
  </launcherArgs>
  <windowImages/>
  <launcher name="timelxne-demo"/>
  <plugins/>
  <features>
    <feature id="org.eclipse.e4.rcp"/>
    <feature id="dev.timelxne.timeline.demo.feature" version="1.0.0.qualifier"/>
  </features>
  <configurations>
    <plugin id="org.apache.felix.scr" autoStart="true" startLevel="2"/>
    <plugin id="org.eclipse.core.runtime" autoStart="true" startLevel="4"/>
    <plugin id="org.eclipse.equinox.common" autoStart="true" startLevel="2"/>
    <plugin id="org.eclipse.equinox.event" autoStart="true" startLevel="2"/>
    <plugin id="org.eclipse.equinox.simpleconfigurator" autoStart="true" startLevel="1"/>
  </configurations>
</product>
